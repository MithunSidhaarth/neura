# Copy this file to .env.local (same folder) and fill in your key(s).
# Get a free Groq key at https://console.groq.com/keys
#
# This powers app/api/ai/route.ts -- AI topic explanation, AI-generated
# graph expansion, the chat panel, and (together with GEMINI_API_KEY
# below) the claim side of "Debate with AI". The key is only ever read
# server-side (inside the Next.js route handler); it is never sent to
# the browser. Without it, everything else in the app still works
# (Wikipedia expansion, the 3D graph, search) -- only the "Explain with
# AI" / "Expand with AI" / chat / debate features will show an error.

GROQ_API_KEY=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

# Get a free key at https://cloud.cerebras.ai
#
# Powers the "against" (rebuttal) side of both debate features --
# "Expand topic with AI" (the one-shot claim/rebuttal neuron graph) and
# live Debate Mode (the two-AI back-and-forth). Deliberately a separate
# provider from Groq rather than a second Groq model: Cerebras runs on
# its own free-tier quota, so a long live debate (one API call per turn,
# no natural stopping point) can't burn through the same rate-limit
# bucket that Groq shares across every other AI feature in the app --
# that shared-bucket exhaustion is what used to surface as a 429 "Rate
# limit reached" error mid-debate. Without CEREBRAS_API_KEY, everything
# else works; only the "against" side of a debate will show an error.

CEREBRAS_API_KEY=csk-mfxk6nnk33jj659hy5r3j45ncfyjvy3d9vy532xcee9nykxe

# Get a free key at https://app.tavily.com (1,000 free searches/month,
# no card required)
#
# Powers "Around the web" / "Videos" in the InfoPanel. Without it, that
# section just shows plain "search the web for this" / "search YouTube
# for this" links instead of live results -- everything else in the
# app works the same either way.

TAVILY_API_KEY=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
